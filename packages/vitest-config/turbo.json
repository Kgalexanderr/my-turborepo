{
  "extends": ["//"],
  "tasks": {
    "merge-blob-reports": {
      "dependsOn": [
        "build",
        "web#test",
        "dashboard#test",
        "blank#test",
        "@repo/ui#test"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/coverage/blob/**",
        "$TURBO_ROOT$/packages/ui/coverage/blob/**"
      ],
      "outputs": ["coverage/merged-blob/**"]
    },
    "report": {
      "dependsOn": ["merge-blob-reports"],
      "outputs": ["coverage/report/**"]
    },
    "view-report": {
      "dependsOn": ["report"],
      "cache": false
    }
  }
}

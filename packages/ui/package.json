{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "license": "MIT",
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch --reporter=default --coverage.enabled=false"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "jsdom": "30.1.3",
    "vitest": "5.1.0",
    "@testing-library/user-event": "14.6.10",
    "react-dom": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@repo/tailwind-config": "workspace:*"
  },
  "private": true,
  "type": "module"
}

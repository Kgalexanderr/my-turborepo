{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@repo/ui/*": ["./src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules"]
}

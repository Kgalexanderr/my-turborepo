{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@repo/ui/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src", "vitest.config.ts", "vitest.d.ts"],
  "exclude": ["dist", "build", "node_modules"]
}

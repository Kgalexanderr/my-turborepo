{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    "./constants/*": "./src/constants/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch --reporter=default --coverage.enabled=false"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@repo/db": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "react": "19.3.1"
  }
}
